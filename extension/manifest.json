{
  "manifest_version": 3,
  "name": "AgreeWise AI",
  "version": "0.2.1",
  "description": "Know what you agree to. A simple summary and risk score for Terms & Privacy Policies, in English and Tamil.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AgreeWise AI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"]
}
